# Streamlit secrets template — copy to secrets.toml and fill in the real values.
#
# DO NOT commit secrets.toml to git. Only this .template file is committed.
# On Streamlit Community Cloud, paste the [gcp_service_account] block into
# Settings → Secrets (no need for a file there).

[gcp_service_account]
type                        = "service_account"
project_id                  = "jf-5530"
private_key_id              = "YOUR_PRIVATE_KEY_ID"
private_key                 = "-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_LINES_HERE\n-----END RSA PRIVATE KEY-----\n"
client_email                = "claude-agent@jf-5530.iam.gserviceaccount.com"
client_id                   = "YOUR_CLIENT_ID"
auth_uri                    = "https://accounts.google.com/o/oauth2/auth"
token_uri                   = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url        = "https://www.googleapis.com/robot/v1/metadata/x509/claude-agent%40jf-5530.iam.gserviceaccount.com"
